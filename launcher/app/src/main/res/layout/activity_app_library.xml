<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090A0D"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingTop="38dp"
    android:paddingEnd="56dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/appLibraryBack"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/app_library_glass"
            android:contentDescription="@string/library_back"
            android:focusable="true"
            android:padding="14dp"
            android:scaleType="center"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_weight="1"
            android:fontFamily="@font/outfit_medium"
            android:text="@string/all_apps"
            android:textColor="#F2F4F7"
            android:textSize="38sp" />

        <EditText
            android:id="@+id/appLibraryFilter"
            android:layout_width="304dp"
            android:layout_height="54dp"
            android:background="@drawable/app_library_glass"
            android:hint="@string/library_filter"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:singleLine="true"
            android:textColor="#F2F4F7"
            android:textColorHint="#A6FFFFFF"
            android:textSize="17sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="34dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appLibraryGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/appLibraryEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/outfit_regular"
            android:text="@string/library_filter_empty"
            android:textColor="#A6FFFFFF"
            android:textSize="19sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
