<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:contentDescription="@string/reorder_controls_description"
    android:accessibilityLiveRegion="polite">

    <ImageView
        style="@style/ReorderKey"
        android:src="@drawable/ic_move" />

    <TextView
        style="@style/ReorderCaption"
        android:text="@string/reorder_move" />

    <ImageView
        style="@style/ReorderKey"
        android:src="@drawable/ic_done" />

    <TextView
        style="@style/ReorderCaption"
        android:text="@string/reorder_done" />

    <ImageView
        style="@style/ReorderKey"
        android:src="@drawable/ic_chevron_left" />

    <TextView
        style="@style/ReorderCaption"
        android:layout_marginEnd="0dp"
        android:text="@string/reorder_finish" />
</LinearLayout>
