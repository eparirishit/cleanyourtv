<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/glass_surface_focus_top" android:endColor="@color/glass_surface_focus_bottom" />
            <stroke android:width="1dp" android:color="@color/glass_focus_border" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/glass_surface_top" android:endColor="@color/glass_surface_bottom" />
            <stroke android:width="1dp" android:color="@color/glass_surface_border" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</selector>
