<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/glass_pressed_top" android:endColor="@color/glass_pressed_bottom" />
            <stroke android:width="1dp" android:color="@color/glass_pressed_border" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/glass_focus_top" android:endColor="@color/glass_focus_bottom" />
            <stroke android:width="1dp" android:color="@color/glass_focus_border" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
