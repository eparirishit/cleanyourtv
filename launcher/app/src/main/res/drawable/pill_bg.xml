<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/glass_surface_focus_top" android:endColor="@color/glass_surface_focus_bottom" />
            <stroke android:width="1dp" android:color="@color/glass_focus_border" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/glass_control_top" android:endColor="@color/glass_control_bottom" />
            <stroke android:width="1dp" android:color="@color/glass_control_border" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
