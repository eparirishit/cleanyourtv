<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/glass_surface_focus_top" android:endColor="@color/glass_surface_focus_bottom" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="@color/glass_focus_border" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#334DAE6D" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FF4DAE6D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/glass_surface_top" android:endColor="@color/glass_surface_bottom" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
